# Copia este archivo a .env (cp .env.example .env). El .env real NO se sube al repositorio.

# --- PostgreSQL (los usa docker-compose para crear la base) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sistema_mantenimiento

# --- Conexiones para ejecutar la API fuera de Docker (uvicorn local) ---
# Dentro de Docker, docker-compose.yml las sobrescribe con los nombres de servicio.
POSTGRES_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sistema_mantenimiento
MONGO_DB_URL=mongodb://localhost:27017
MONGO_DB_NAME=mantenimiento
REDIS_URL=redis://localhost:6379/0

# --- Seguridad (JWT). Cambia SECRET_KEY en cualquier entorno que no sea tu máquina ---
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS: orígenes del frontend separados por comas (3000 = Next/CRA, 5173 = Vite) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
