# Copia este archivo a .env (cp .env.example .env). El .env real NO se sube al repositorio.

# --- PostgreSQL (los usa docker-compose) ---
POSTGRES_USER=cell
POSTGRES_PASSWORD=cell
POSTGRES_DB=cell

# --- Conexiones para ejecutar la API fuera de Docker (uvicorn local) ---
DATABASE_URL=postgresql+psycopg://cell:cell@localhost:5432/cell
MONGO_URL=mongodb://localhost:27017
MONGO_DB=cell_sensores
REDIS_URL=redis://localhost:6379/0

# --- CORS: orígenes del frontend separados por comas (3000 = Next/CRA, 5173 = Vite) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
